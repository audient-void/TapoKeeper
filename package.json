{
  "name": "tapokeeper",
  "version": "2.0.0",
  "description": "TapoKeeper - Monitor and control TP-Link Tapo Smart Plugs with real-time power tracking (TypeScript + NodeGUI)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "tapokeeper": "./dist/index.js"
  },
  "scripts": {
    "start": "npm run build && node dist/index.js",
    "start:gui": "npm run build && node dist/index.js",
    "start:cli": "node src/index-cli.js",
    "cli": "node src/index-cli.js",
    "dev": "tsc --watch",
    "build": "tsc",
    "help": "node src/index-cli.js --help",
    "dump": "node src/index-cli.js --dump",
    "graph": "node src/index-cli.js --graph",
    "verbose": "node src/index-cli.js --verbose",
    "clean": "rm -rf dist",
    "package:win": "npm run build && qode-native-packer --entry dist/index.js --output tapokeeper-win.exe --target win",
    "package:mac": "npm run build && qode-native-packer --entry dist/index.js --output tapokeeper-mac --target mac",
    "package:linux": "npm run build && qode-native-packer --entry dist/index.js --output tapokeeper-linux --target linux"
  },
  "keywords": [
    "tapo",
    "tplink",
    "power",
    "monitoring",
    "nodegui",
    "typescript"
  ],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@nodegui/nodegui": "^0.58.0",
    "@nodegui/qode": "^2.0.0",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "cli-table3": "^0.6.3",
    "colors": "^1.4.0",
    "tp-link-tapo-connect": "^2.0.8"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "@nodegui/packer": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
